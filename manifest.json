{
  "manifest_version": 3,
  "name": "CrainteAI",
  "version": "2.0.1",
  "description": "Real-time website security verification using AI and OSINT.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check security"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
  "https://www.virustotal.com/*",
  "https://api.groq.com/*"
  ],
  "icons": {
  "128": "image.png"
}
}